#	Makefile.wolfssl for Minix
#	wolfSSL integration for Minix build system

.ifndef _MAKEFILE_WOLFSSL_INCLUDED
_MAKEFILE_WOLFSSL_INCLUDED=1

.include <bsd.own.mk>

WOLFSSLSRC=	${CRYPTODIST}/external/gpl2/wolfssl/dist
CPPFLAGS+=	-DWOLFSSLDIR=\"/etc/wolfssl\"
CPPFLAGS+=	-DWOLFSSL_ENGINESDIR=\"/usr/lib/wolfssl\"

# wolfSSL-specific configuration for Minix
.if defined(__MINIX)
CPPFLAGS+=	-DWOLFSSL_MINIX
CPPFLAGS+=	-DWOLFSSL_NO_SCTP
CPPFLAGS+=	-DWOLFSSL_SMALL_STACK
CPPFLAGS+=	-DWOLFSSL_NO_OLD_TLS
.endif # defined(__MINIX)

# Enable OpenSSL compatibility layer
CPPFLAGS+=	-DOPENSSL_EXTRA
CPPFLAGS+=	-DOPENSSL_EXTRA_X509_SMALL

# Enable required cryptographic algorithms
CPPFLAGS+=	-DHAVE_AESGCM
CPPFLAGS+=	-DHAVE_CHACHA
CPPFLAGS+=	-DHAVE_POLY1305
CPPFLAGS+=	-DHAVE_ECC
CPPFLAGS+=	-DHAVE_CURVE25519
CPPFLAGS+=	-DHAVE_ED25519
CPPFLAGS+=	-DHAVE_DH
CPPFLAGS+=	-DHAVE_RSA
CPPFLAGS+=	-DHAVE_DSA
CPPFLAGS+=	-DHAVE_SHA
CPPFLAGS+=	-DHAVE_SHA256
CPPFLAGS+=	-DHAVE_SHA512
CPPFLAGS+=	-DHAVE_MD5

# Disable unused features to reduce size
CPPFLAGS+=	-DNO_MD4
CPPFLAGS+=	-DNO_RC4
CPPFLAGS+=	-DNO_PSK
CPPFLAGS+=	-DNO_HC128
CPPFLAGS+=	-DNO_RABBIT
CPPFLAGS+=	-DNO_DES3
# Note: NO_DSA and NO_DH intentionally omitted.
# HAVE_DSA and HAVE_DH are needed by BIND and syslogd.
CPPFLAGS+=	-DNO_OLD_TLS

# DTLS support (RFC 6347/9147) for DTLS over UDP in lwIP.
# NOTE: NO_WOLFSSL_CLIENT and NO_WOLFSSL_SERVER are intentionally REMOVED
# to allow DTLS client/server handshake (wolfSSL_connect/wolfSSL_accept).
# The original defines reduced code size but blocked DTLS functionality.
# syslogd (TLS over TCP) is unaffected by this change: the client/server
# code paths are compiled but the OpenSSL compat layer still works.
CPPFLAGS+=	-DWOLFSSL_DTLS
CPPFLAGS+=	-DWOLFSSL_DTLS13

# Performance optimizations
CPPFLAGS+=	-DFAST_MATH
CPPFLAGS+=	-DSMALL_STACK
# Note: SINGLE_THREADED removed to avoid multi-core processing bug

.endif
